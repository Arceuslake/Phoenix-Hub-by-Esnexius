--==================================================
-- FIND FARMER'S MARKET
--==================================================

local function FindFarmersMarket()

    local PossibleNames = {
        "FarmersMarket",
        "FarmerMarket",
        "Farmers Market",
        "Farmer's Market",
        "FarmersMarketTeleport",
        "FarmerMarketTeleport"
    }

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        local ObjectName =
            string.lower(Object.Name or "")

        for _, Name in ipairs(
            PossibleNames
        ) do

            if ObjectName ==
                string.lower(Name) then

                return Object
            end
        end
    end

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if Object:IsA("ProximityPrompt") then

            local ActionText =
                string.lower(
                    Object.ActionText or ""
                )

            local ObjectText =
                string.lower(
                    Object.ObjectText or ""
                )

            local Combined =
                ActionText ..
                " " ..
                ObjectText

            if string.find(
                Combined,
                "farmer",
                1,
                true
            )
            and string.find(
                Combined,
                "market",
                1,
                true
            ) then

                return Object
            end
        end
    end

    return nil
end

--==================================================
-- TELEPORT TO FARMER'S MARKET
--==================================================

local function TeleportToFarmersMarket()

    local Target =
        FindFarmersMarket()

    if not Target then
        return false
    end

    if Target:IsA("ProximityPrompt") then

        local Success =
            pcall(function()
                fireproximityprompt(Target)
            end)

        return Success
    end

    local Character =
        LocalPlayer.Character

    if not Character then
        return false
    end

    local Root =
        Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not Root then
        return false
    end

    if Target:IsA("BasePart") then

        Root.CFrame =
            Target.CFrame +
            Vector3.new(0, 3, 0)

        return true
    end

    local Part =
        Target:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if Part then

        Root.CFrame =
            Part.CFrame +
            Vector3.new(0, 3, 0)

        return true
    end

    return false
end

