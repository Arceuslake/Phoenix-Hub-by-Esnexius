--==================================================
-- SCANNER
--==================================================

local ScannerResults =
    "No scan performed yet."

local ScannerParagraph =
    BoothTab:CreateParagraph({
        Title = "🔎 Scanner Results",
        Content = ScannerResults
    })

BoothTab:CreateButton({
    Name = "🔍 Scan Booth Skin UI",

    Callback = function()

        local Content =
            GetBoothSkinContent()

        if not Content then

            ScannerResults =
                "TradeBoothSkinSelector not found.\n\n" ..
                "Open the Trade Booth Skins window first."

        else

            local Results = {}
            local Found = 0

            for _, Item in ipairs(
                Content:GetChildren()
            ) do

                Found += 1

                local Text = ""

                for _, Object in ipairs(
                    Item:GetDescendants()
                ) do

                    if Object:IsA("TextLabel")
                    or Object:IsA("TextButton") then

                        if Object.Text
                        and Object.Text ~= "" then

                            Text =
                                Object.Text

                            break
                        end
                    end
                end

                table.insert(
                    Results,
                    "ITEM #" ..
                    Found ..
                    "\nName: " ..
                    Item.Name ..
                    "\nClass: " ..
                    Item.ClassName ..
                    "\nText: " ..
                    Text ..
                    "\nPath: " ..
                    Item:GetFullName()
                )
            end

            if Found == 0 then

                ScannerResults =
                    "Content folder is empty."

            else

                ScannerResults =
                    "Found " ..
                    Found ..
                    " booth skin objects:\n\n" ..
                    table.concat(
                        Results,
                        "\n\n"
                    )
            end
        end

        pcall(function()

            ScannerParagraph:Set({
                Title = "🔎 Scanner Results",
                Content = ScannerResults
            })

        end)

        Rayfield:Notify({
            Title = "Booth Scanner",
            Content = "Scan complete!",
            Duration = 3
        })
    end
})

