--==================================================
-- GET BOOTH SKIN CONTENT
--==================================================

local function GetBoothSkinContent()

    local PlayerGui =
        LocalPlayer:FindFirstChild("PlayerGui")

    if not PlayerGui then
        return nil
    end

    local Selector =
        PlayerGui:FindFirstChild(
            "TradeBoothSkinSelector"
        )

    if not Selector then
        return nil
    end

    local SkinSelector =
        Selector:FindFirstChild("SkinSelector")

    if not SkinSelector then
        return nil
    end

    local Main =
        SkinSelector:FindFirstChild("Main")

    if not Main then
        return nil
    end

    local Skins =
        Main:FindFirstChild("Skins")

    if not Skins then
        return nil
    end

    local ScrollerHolder =
        Skins:FindFirstChild("ScrollerHolder")

    if not ScrollerHolder then
        return nil
    end

    local Scroller =
        ScrollerHolder:FindFirstChild("Scroller")

    if not Scroller then
        return nil
    end

    return Scroller:FindFirstChild("Content")
end

--==================================================
-- FIND DEFAULT STALL
--==================================================

local function FindDefaultStall()

    local Content =
        GetBoothSkinContent()

    if not Content then
        return nil
    end

    for _, Item in ipairs(
        Content:GetChildren()
    ) do

        if string.lower(Item.Name) == "default" then
            return Item
        end

        for _, Object in ipairs(
            Item:GetDescendants()
        ) do

            if Object:IsA("TextLabel")
            or Object:IsA("TextButton") then

                local Text =
                    string.lower(
                        Object.Text or ""
                    )

                if Text == "default stall"
                or Text == "default" then

                    return Item
                end
            end
        end
    end

    return nil
end

--==================================================
-- FIND CLAIM PROMPT
--==================================================

local function FindClaimPrompt()

    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if not _G.AutoClaimBooth then
            return nil
        end

        if Object:IsA("ProximityPrompt") then

            local ActionText =
                string.lower(
                    Object.ActionText or ""
                )

            local ObjectText =
                string.lower(
                    Object.ObjectText or ""
                )

            if string.find(
                ActionText,
                "claim",
                1,
                true
            )
            or string.find(
                ObjectText,
                "claim",
                1,
                true
            ) then

                return Object
            end
        end
    end

    return nil
end

--==================================================
-- SELECT DEFAULT STALL
--==================================================

local function SelectDefaultStall()

    local DefaultStall

    for i = 1, 40 do

        if not _G.AutoClaimBooth then
            return false
        end

        DefaultStall =
            FindDefaultStall()

        if DefaultStall then
            break
        end

        task.wait(0.25)
    end

    if not DefaultStall then

        Rayfield:Notify({
            Title = "Auto Claim Booth",
            Content =
                "Default Stall was not found.",
            Duration = 3
        })

        return false
    end

    local Button = nil

    if DefaultStall:IsA("TextButton")
    or DefaultStall:IsA("ImageButton") then

        Button = DefaultStall

    else

        Button =
            DefaultStall:FindFirstChildWhichIsA(
                "TextButton",
                true
            )

        if not Button then

            Button =
                DefaultStall:FindFirstChildWhichIsA(
                    "ImageButton",
                    true
                )

        end
    end

    if Button then

        local Success = false

        pcall(function()

            firesignal(
                Button.Activated
            )

            Success = true

        end)

        pcall(function()

            firesignal(
                Button.MouseButton1Click
            )

            Success = true

        end)

        return Success
    end

    return false
end

